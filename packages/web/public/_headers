# Response headers (Netlify _headers). vite.config.ts fills the connect-src placeholder from the configured hosts at build.
# 03 DR-1/DR-2/DR-6, D-03, D-18. Netlify header rules have no path negation, and rules matching the same path
# are expected to combine (UNVERIFIED: check on the deploy preview), so the strict app policy is attached to the
# app's route patterns, never to /*: the script runner below needs its own policy and must not receive the app's
# frame-ancestors 'none'.
# /:page also covers /index.html and the root files (favicon, manifest, snapshots.json); a second rule for
# /index.html would set the same names twice on one path, whose combination is UNVERIFIED.
# Deep paths no pattern lists (e.g. /no/such/page) still get index.html through the SPA fallback; whether Netlify
# matches them on the request path or on /index.html is UNVERIFIED, so the app also refuses to render inside a
# frame (src/framing.ts).
# A route added to the app needs its pattern here (headers test in src/headers.test.ts).

# Every path: harmless for the runner too.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src {{CONNECT_SRC}}; frame-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY

/:page
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src {{CONNECT_SRC}}; frame-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY

/1/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src {{CONNECT_SRC}}; frame-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY

/100/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src {{CONNECT_SRC}}; frame-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY

/10200/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src {{CONNECT_SRC}}; frame-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY

/11155111/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src {{CONNECT_SRC}}; frame-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY

/cases/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src {{CONNECT_SRC}}; frame-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY

# Built files (hashed JS, CSS, SVG): DR-2 covers every response, not only pages.
/assets/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src {{CONNECT_SRC}}; frame-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY

# Dynamic-script runner (D-18 DECIDED, like the Dispute Resolver's ADR 0004): opaque origin however it is loaded,
# only the app may frame it. Enforced header, never report-only or <meta>.
/__runner/*
  Content-Security-Policy: sandbox allow-scripts; frame-ancestors 'self'; script-src 'self' 'unsafe-eval'; object-src 'none'; base-uri 'none'
  X-Frame-Options: SAMEORIGIN
