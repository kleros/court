{
  "name": "@court/web",
  "version": "0.0.0",
  "description": "The Kleros Court single-page app.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "yarn run -T eslint --max-warnings 0 .",
    "test": "vitest run",
    "build": "node scripts/emit-snapshots.mjs && vite build",
    "e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@court/core": "workspace:^",
    "@kleros/ui-components-library": "3.10.0",
    "@reown/appkit": "1.8.24",
    "@reown/appkit-adapter-wagmi": "1.8.24",
    "@reown/appkit-controllers": "1.8.24",
    "@sentry/react": "10.77.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "5.105.0",
    "@wagmi/core": "2.22.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "18.3.1",
    "react-markdown": "9.1.0",
    "react-router": "7.18.4",
    "tailwindcss": "4.3.3",
    "tailwindcss-react-aria-components": "2.2.0",
    "viem": "2.57.12",
    "wagmi": "2.19.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
