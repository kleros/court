{
  "name": "court-workspace",
  "version": "1.0.0",
  "description": "The Kleros Court user interface.",
  "repository": "https://github.com/kleros/court",
  "author": "Kleros",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22.22.3"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "yarn workspaces foreach --all --topological-dev --exclude court-workspace run typecheck",
    "lint": "eslint --max-warnings 0 . && prettier --check .",
    "format": "prettier --write .",
    "test": "yarn workspaces foreach --all --topological-dev --exclude court-workspace run test",
    "build": "yarn workspaces foreach --all --topological-dev --exclude court-workspace run build",
    "preflight:rpc": "node packages/core/scripts/preflight-rpc.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.2.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "resolutions": {
    "@wagmi/connectors": "6.2.0",
    "@reown/appkit-utils@npm:1.8.24": "patch:@reown/appkit-utils@npm%3A1.8.24#~/.yarn/patches/@reown-appkit-utils-npm-1.8.24-0f627c3d47.patch",
    "@walletconnect/keyvaluestorage@npm:1.1.1": "patch:@walletconnect/keyvaluestorage@npm%3A1.1.1#~/.yarn/patches/@walletconnect-keyvaluestorage-npm-1.1.1-4cdf80afee.patch",
    "@reown/appkit@npm:1.8.24": "patch:@reown/appkit@npm%3A1.8.24#~/.yarn/patches/@reown-appkit-npm-1.8.24-09809d4cb9.patch"
  }
}
