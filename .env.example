# Every variable the app (packages/web) reads. Names only: values live in the Netlify dashboard or a local .env.
# Names are today's production names, so the dashboard values reach the new app unchanged.
# Anything unset: the build still passes. No RPC for a chain = reads on that chain fail (never a public fallback);
# no Reown project id = read-only, nothing can connect; no Sentry DSN = Sentry off.

# --- Read RPC (https), Court chains: the app's own reads, also the dynamic-script runner's ---
REACT_APP_WEB3_FALLBACK_HTTPS_URL=
REACT_APP_WEB3_FALLBACK_XDAI_HTTPS_URL=
REACT_APP_WEB3_FALLBACK_SEPOLIA_HTTPS_URL=
REACT_APP_WEB3_FALLBACK_CHIADO_HTTPS_URL=

# --- Read RPC (https), other chains: only the dynamic-script runner's RPC redirect ---
REACT_APP_WEB3_FALLBACK_OPTIMISM_HTTPS_URL=
REACT_APP_WEB3_FALLBACK_OPTIMISMSEPOLIA_HTTPS_URL=
REACT_APP_WEB3_FALLBACK_UNICHAIN_HTTPS_URL=
REACT_APP_WEB3_FALLBACK_UNICHAINSEPOLIA_HTTPS_URL=
REACT_APP_WEB3_FALLBACK_POLYGON_HTTPS_URL=
REACT_APP_WEB3_FALLBACK_MUMBAI_HTTPS_URL=
REACT_APP_WEB3_FALLBACK_ZKSYNC_HTTPS_URL=
REACT_APP_WEB3_FALLBACK_ZKSYNCSEPOLIA_HTTPS_URL=
REACT_APP_WEB3_FALLBACK_REDSTONE_HTTPS_URL=
REACT_APP_WEB3_FALLBACK_ARBITRUM_HTTPS_URL=
REACT_APP_WEB3_FALLBACK_ARBITRUMSEPOLIA_HTTPS_URL=
REACT_APP_WEB3_FALLBACK_BASE_HTTPS_URL=
REACT_APP_WEB3_FALLBACK_BASE_SEPOLIA_HTTPS_URL=

