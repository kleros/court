# Dependencies
node_modules/
.yarn/*
!.yarn/patches
!.yarn/releases

# Build output
packages/*/dist/
/legacy/build/

# Generated at build time from src/assets/snapshots.json
packages/web/public/snapshots.json
# Generated by the old app's build (legacy/)
/legacy/public/snapshots.json

# Tests
coverage/
# vitest's JSON reporter writes here when run with --reporter=json and no output file
packages/*/.vitest/
packages/*/test-results/
packages/*/playwright-report/

# Logs
yarn-debug.log*
yarn-error.log*

# Editors
/.vscode/
/.idea/*
.vim*

# Misc
.DS_Store
*.tsbuildinfo

.env
.env.*
!.env.example
