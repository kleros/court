{
  "name": "court",
  "version": "0.4.0",
  "description": "The Kleros Court user interface.",
  "keywords": [
    "blockchain",
    "ethereum",
    "dapp",
    "kleros",
    "court"
  ],
  "repository": "https://github.com/kleros/court",
  "author": "Kleros",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "node scripts/emit-snapshots.js && vite",
    "build": "node scripts/emit-snapshots.js && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@kleros/ui-components-library": "3.10.0",
    "@reown/appkit": "1.8.24",
    "@reown/appkit-adapter-wagmi": "1.8.24",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "5.105.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "18.3.1",
    "tailwindcss": "4.3.3",
    "tailwindcss-react-aria-components": "2.2.0",
    "viem": "2.57.14",
    "wagmi": "2.19.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "resolutions": {
    "@wagmi/connectors": "6.2.0"
  }
}
