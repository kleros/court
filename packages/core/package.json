{
  "name": "@court/core",
  "version": "0.0.0",
  "description": "Framework-free Kleros Court logic: chains, data, votes. No React, no DOM. Consumed from source, so build = type check.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "yarn run -T eslint --max-warnings 0 .",
    "test": "vitest run",
    "build": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "viem": "2.57.12"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
